{
  "$schema": "../../specs/003-model-abstraction/contracts/appsettings.schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Extensions.Http": "Information"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "DefaultModel": "phi-4-mini",
    "PromptFile": "weather-assistant.md",
    "Models": {
      "phi-4-mini": {
        "Name": "Phi-4-mini-instruct-generic-cpu:5",
        "Provider": "FoundryLocal",
        "Endpoint": "http://localhost:63336/v1",
        "ToolInvocationStrategy": "Functools"
      },
      "qwen2.5-vl-3b": {
        "Name": "qwen2.5-vl:3b-instruct",
        "Provider": "Ollama",
        "Endpoint": "http://localhost:11434",
        "ToolInvocationStrategy": "Functools"
      }
    }
  },
  "OpenMeteo": {
    "GeocodeBaseUrl": "https://geocoding-api.open-meteo.com/v1/",
    "WeatherBaseUrl": "https://api.open-meteo.com/v1/",
    "AirQualityBaseUrl": "https://air-quality-api.open-meteo.com/v1/",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3
  }
}
