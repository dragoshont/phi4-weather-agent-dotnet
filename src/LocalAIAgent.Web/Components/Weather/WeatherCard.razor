@using LocalAIAgent.Agent.Models

@if (Weather is not null)
{
    <div class="weather-card" role="region" aria-label="Weather forecast for @LocationName">
        <!-- Location Header -->
        <div class="weather-card-header">
            <h3 class="weather-location">@LocationName</h3>
            @if (!string.IsNullOrEmpty(Weather.Timezone))
            {
                <span class="weather-timezone">@Weather.Timezone</span>
            }
        </div>

        <!-- Current Conditions -->
        <div class="weather-current" aria-label="Current weather conditions">
            <div class="current-temp-group">
                <span class="current-temp">@($"{Weather.Current.Temperature:F1}°")</span>
                <span class="current-description">@Weather.Current.Description</span>
            </div>
            <div class="current-details">
                <div class="detail-item">
                    <span class="detail-label">Precipitation:</span>
                    <span class="detail-value">@($"{Weather.Current.Precipitation:F1}mm")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Wind:</span>
                    <span class="detail-value">@($"{Weather.Current.WindSpeed:F1} km/h")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Cloud Cover:</span>
                    <span class="detail-value">@($"{Weather.Current.CloudCover}%")</span>
                </div>
            </div>
        </div>

        <!-- Daily Forecasts -->
        @if (Weather.Daily.Count > 0)
        {
            <div class="weather-forecast" aria-label="@Weather.Daily.Count day forecast">
                <h4 class="forecast-title">@Weather.Daily.Count-Day Forecast</h4>
                <div class="forecast-days">
                    @foreach (var day in Weather.Daily)
                    {
                        <div class="forecast-day" role="article" aria-label="Forecast for @day.Date.ToString("dddd, MMMM d")">
                            <div class="day-header">
                                <span class="day-date">@day.Date.ToString("ddd, MMM d")</span>
                                <span class="day-description">@day.Description</span>
                            </div>
                            <div class="day-temps">
                                <span class="temp-high" aria-label="High temperature">
                                    <span class="temp-label">High:</span> @($"{day.TemperatureMax:F1}°")
                                </span>
                                <span class="temp-low" aria-label="Low temperature">
                                    <span class="temp-label">Low:</span> @($"{day.TemperatureMin:F1}°")
                                </span>
                            </div>
                            @if (day.PrecipitationSum > 0)
                            {
                                <div class="day-precipitation" aria-label="Precipitation">
                                    <span class="precip-label">Rain:</span> @($"{day.PrecipitationSum:F1}mm")
                                </div>
                            }
                            <div class="day-sun-times">
                                <span class="sunrise" aria-label="Sunrise time">
                                    ☀️ @day.Sunrise.ToString("h:mm tt")
                                </span>
                                <span class="sunset" aria-label="Sunset time">
                                    🌙 @day.Sunset.ToString("h:mm tt")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// Weather data to display
    /// </summary>
    [Parameter]
    public WeatherData? Weather { get; set; }

    /// <summary>
    /// Location name for display (e.g., "Seattle, WA, USA")
    /// </summary>
    [Parameter]
    public string LocationName { get; set; } = "Unknown Location";
}
